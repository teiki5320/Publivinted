{
  "manifest_version": 3,
  "name": "Publivinted",
  "version": "0.2.0",
  "description": "Publie sur Vinted les annonces validées dans l'appli Publivinted.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.vinted.fr/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Publivinted",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/items/new*"],
      "js": ["selectors.js", "test-listing.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://publivinted.REMPLACER.workers.dev/*", "http://localhost:8787/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["test/*"],
      "matches": ["https://www.vinted.fr/*"]
    }
  ]
}
